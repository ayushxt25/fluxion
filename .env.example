APP_NAME=Fluxion
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://fluxion:fluxion@localhost:5432/fluxion
TEST_DATABASE_URL=postgresql+asyncpg://fluxion:fluxion@localhost:5432/fluxion_test
REDIS_URL=redis://localhost:6379/0
DISPATCH_QUEUE_NAME=fluxion:dispatch
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=10
SCHEDULER_POLL_SECONDS=1.0
OUTBOX_POLL_SECONDS=1.0
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_SECONDS=30
LEASE_REAPER_INTERVAL_SECONDS=5
