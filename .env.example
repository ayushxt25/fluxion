APP_NAME=Fluxion
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://fluxion:fluxion@localhost:5432/fluxion
TEST_DATABASE_URL=postgresql+asyncpg://fluxion:fluxion@localhost:5432/fluxion_test
REDIS_URL=redis://localhost:6379/0
DISPATCH_QUEUE_NAME=fluxion:dispatch
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=10
SCHEDULER_POLL_SECONDS=1.0
OUTBOX_POLL_SECONDS=1.0
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_SECONDS=30
LEASE_REAPER_INTERVAL_SECONDS=5
AUTH_ENABLED=true
JWT_SECRET=replace-with-a-strong-development-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=fluxion
JWT_AUDIENCE=fluxion-api
JWT_ACCESS_TOKEN_MINUTES=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_VIEWER_PER_MINUTE=120
RATE_LIMIT_OPERATOR_PER_MINUTE=90
RATE_LIMIT_ADMIN_PER_MINUTE=60
RATE_LIMIT_OPS_PER_MINUTE=20
MAX_REQUEST_BODY_BYTES=1048576
